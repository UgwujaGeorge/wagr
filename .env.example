# Frontend
VITE_DEFAULT_CHAIN=baseSepolia
VITE_BASE_SEPOLIA_CHAIN_ID=84532
VITE_BASE_MAINNET_CHAIN_ID=8453
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_BASE_MAINNET_RPC_URL=https://mainnet.base.org
VITE_BASE_SEPOLIA_ESCROW_ADDRESS=0xA93956bc90698b4Bf9080085c9047F55625381aE
VITE_BASE_MAINNET_ESCROW_ADDRESS=0x13dF0E047a7D9db5fe4d7918D1663a04eD0bD09d
VITE_RELAYER_URL=http://localhost:8787

# Relayer
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_ESCROW_ADDRESS=0xA93956bc90698b4Bf9080085c9047F55625381aE
BASE_MAINNET_ESCROW_ADDRESS=0x13dF0E047a7D9db5fe4d7918D1663a04eD0bD09d
# Pays gas only. It carries no authority to decide a verdict.
RELAYER_PRIVATE_KEY=
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
GENLAYER_RESOLVER_ADDRESS=0xC3E076B3CA2407D4Cf30E03E960232D1A764A08e
RELAYER_PORT=8787
RELAYER_DATA_FILE=.wagr-relayer-data.json

# Attestation
# This process's own attester identity. Must be registered on the escrow.
WAGR_ATTESTER_PRIVATE_KEY=
# Comma-separated independent attester services asked to co-sign each verdict.
WAGR_ATTESTER_ENDPOINTS=
# Shared secret guarding /attest.
WAGR_ATTESTER_AUTH_TOKEN=
# Never set this to false outside local development: an ACCEPTED GenLayer
# verdict can still be overturned on appeal.
WAGR_REQUIRE_GENLAYER_FINALITY=true

# Deployment
DEPLOYER_PRIVATE_KEY=
PRIVATE_KEY=do_not_commit_real_value
GENLAYER_ACCOUNT_PRIVATE_KEY=
OWNER_ADDRESS=
# Comma-separated attester addresses baked into the escrow at deploy time.
WAGR_ATTESTERS=
WAGR_ATTESTER_THRESHOLD=2
WAGR_CHALLENGE_WINDOW_SECONDS=1800
WAGR_RESOLUTION_GRACE_SECONDS=604800
ETHERSCAN_API_KEY=
